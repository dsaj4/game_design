{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/game-analysis/material-pack.schema.json",
  "title": "Game Analysis Material Pack",
  "type": "object",
  "required": ["version", "project", "text_sources", "images", "draft_seed"],
  "properties": {
    "version": {
      "type": "string"
    },
    "project": {
      "type": "object",
      "required": ["game_name", "slug", "analysis_scope", "status", "target_questions"],
      "properties": {
        "game_name": { "type": "string" },
        "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "analysis_scope": { "type": "string" },
        "status": { "type": "string" },
        "target_questions": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "source_note": { "type": "string" }
      }
    },
    "text_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "role"],
        "properties": {
          "path": { "type": "string" },
          "role": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "caption", "observations"],
        "properties": {
          "path": { "type": "string" },
          "caption": { "type": "string" },
          "evidence_tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "observations": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          }
        }
      }
    },
    "draft_seed": {
      "type": "object",
      "description": "Structured notes used by the deterministic draft builder. LLM generation may ignore this field and rely on raw text plus images.",
      "properties": {
        "summary": { "type": "array", "items": { "type": "string" } },
        "positioning": { "type": "string" },
        "experience": { "type": "string" },
        "core_loop_mermaid": { "type": "string" },
        "core_loop_notes": { "type": "array", "items": { "type": "string" } },
        "system_mermaid": { "type": "string" },
        "architecture_notes": { "type": "array", "items": { "type": "string" } },
        "content_notes": { "type": "array", "items": { "type": "string" } },
        "economy_notes": { "type": "array", "items": { "type": "string" } },
        "narrative_notes": { "type": "array", "items": { "type": "string" } },
        "strengths": { "type": "array", "items": { "type": "string" } },
        "weaknesses": { "type": "array", "items": { "type": "string" } },
        "project_transfer": { "type": "array", "items": { "type": "string" } },
        "hypotheses": { "type": "array", "items": { "type": "string" } },
        "unknowns": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
